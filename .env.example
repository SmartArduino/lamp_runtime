# ─────────────────────────────────────────────────────────────
# 台灯运行参数模板
# 复制本文件为 .env 并按需修改：cp .env.example .env
# 注意：注释必须单独成行，不要写在值后面（如 KEY=value  # 注释），
#       bash 的 source 与 systemd 的 EnvironmentFile 都不识别行内注释。
# ─────────────────────────────────────────────────────────────

# 电机/人脸追踪开关（1=启动，默认；0=跳过舵机与人脸追踪）
LELAMP_MOTOR=1

# 音频开关（1=完整功能，默认；0=纯追踪调试模式，跳过 WebSocket/音频）
LELAMP_AUDIO=1

# 回声抑制开关（1=开启，默认；0=关闭）
# 开启：TTS 播放期间暂停麦克风采集并在播放结束后多丢弃一段尾音，
#       防止扬声器声音被采回服务端误触发自动回复；
#       代价是设备说完话后约 1.5 秒内用户说话会被忽略。
# 关闭：播放期间麦克风持续采集（适合用耳机收听、或声卡自带 AEC 时），
#       回声可能被服务端误识别为用户说话。
LELAMP_ECHO_SUPPRESSION=1

# 实时对话后端：qwen（默认）或 glm
LELAMP_RT_PROVIDER=qwen

# Qwen 后端配置（LELAMP_RT_PROVIDER=qwen 时）
DASHSCOPE_API_KEY="Your_DashScope_Key"
QWEN_OMNI_MODEL=qwen3.5-omni-plus-realtime
QWEN_OMNI_VOICE=Tina

# GLM 后端配置（LELAMP_RT_PROVIDER=glm 时）
# ZHIPU_API_KEY="Your_Zhipu_Key"
# ZHIPU_VOICE=male-qn-daxuesheng

# 人脸检测模型路径（板端部署时使用 RKNN/MNN 模型）
LELAMP_RKNN_MODEL=/home/radxa/source/python/lamp_runtime/models/RetinaFace.rknn
